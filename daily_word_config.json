{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "每日一字插件配置",
  "properties": {
    "target_group_id": {
      "type": "string",
      "title": "目标QQ群号",
      "description": "填写需要推送每日一字的QQ群号",
      "default": ""
    },
    "push_time_hour": {
      "type": "integer",
      "title": "推送时间 - 小时",
      "description": "每天推送的小时数 (0-23)",
      "default": 13,
      "minimum": 0,
      "maximum": 23
    },
    "push_time_minute": {
      "type": "integer",
      "title": "推送时间 - 分钟",
      "description": "每天推送的分钟数 (0-59)",
      "default": 0,
      "minimum": 0,
      "maximum": 59
    },
    "admin_qq_list": {
      "type": "array",
      "title": "管理员QQ号列表",
      "description": "可以使用 /HANZI 命令手动触发推送的管理员QQ号列表",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": ["target_group_id"]
}
