{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "每日一字插件配置",
  "properties": {
    "target_group_id": {
      "type": "string",
      "title": "目标QQ群号",
      "description": "填写需要推送每日一字的QQ群号",
      "default": "1067390429"
    },
    "push_time_hour": {
      "type": "integer",
      "title": "推送时间 - 小时",
      "description": "每天推送的小时数 (0-23)。插件默认值为 13，代码中也以 13 为缺省值。",
      "default": 13,
      "minimum": 0,
      "maximum": 23
    },
    "push_time_minute": {
      "type": "integer",
      "title": "推送时间 - 分钟",
      "description": "每天推送的分钟数 (0-59)",
      "default": 0,
      "minimum": 0,
      "maximum": 59
    },
    "admin_qq_list": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string" }
        },
        { "type": "string" }
      ],
      "title": "管理员QQ号列表",
      "description": "可以使用 /HANZI 命令手动触发推送的管理员QQ号列表。支持数组格式或以逗号分隔的字符串（例如: \"123,456\"）。",
      "default": ["2425725194"]
    }
  },
  "required": ["target_group_id"]
}
